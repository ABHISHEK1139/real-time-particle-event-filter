# --- Python build & cache artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
.python-version

# --- Test / lint / coverage caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Secrets / local config ---
.env
*.pem
*.key

# --- Trained model binaries ---
# Compiled weights are reproducible from src/data_download.py + src/train_model.py
# and are not versioned; see MODEL.md. Note that *.joblib is NOT tracked even
# though an older copy existed in the working tree.
*.joblib
*.pt
*.onnx
*.pkl
models/

# --- Datasets ---
# Dimuon_DoubleMu.csv is deliberately un-ignored: it is the official CERN
# educational sample the README documents and CI validates against. The derived
# ROOT copy and the checksum sidecar are build outputs and stay ignored.
*.root
*.root.fingerprint
!Dimuon_DoubleMu.csv

# --- Transient outputs ---
logs/*.tmp
temp/
run_output.txt
clean.txt
*.log

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
