# --- Python build & cache artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
.python-version

# --- Test / lint / coverage caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Local config ---
.env
*.pem
*.key

# Personal commit-message template, installed via
# `git config commit.template .gitmessage`. Deliberately untracked: the
# attribution convention it records is the maintainer's, not a repo rule.
.gitmessage

# --- Trained model binaries: TRACKED ---
# These are committed so a clone can run inference and the dashboard without
# retraining. Regenerate with: python src/train_model.py && python src/anomaly_detection.py
# Transient/alternate formats are still ignored.
*.onnx
*.pkl
*.h5
*.parquet
*.npz
*.feather
*.ckpt
*.dill

# --- Datasets ---
# Both the official CERN CSV and the derived ROOT TTree are tracked, so the
# project is reproducible from a clone with no network access and no build step.
# The checksum sidecar is a local cache and stays ignored.
*.root.fingerprint
!Dimuon_DoubleMu.csv
!Dimuon_DoubleMu.root

# --- Transient outputs ---
logs/*.tmp
temp/
run_output.txt
clean.txt
*.log

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
